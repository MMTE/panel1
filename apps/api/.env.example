# Database
DATABASE_URL="postgresql://username:password@localhost:5432/panel1_dev"

# JWT Secret — MUST be >=32 chars or the API will refuse to boot (fail-closed).
# Generate with: openssl rand -hex 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Encryption Key (32-byte hex-encoded string, change this in production)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# API Configuration
API_PORT=3001
FRONTEND_URL="http://localhost:5173"

# Security: CORS allowlist + CSP connectSrc origin (R13).
# CORS_ORIGIN: comma-separated list of allowed browser origins.
#   In production this is the ONLY source of truth (localhost is denied).
#   In development, http(s)://localhost:* and 127.0.0.1:* are also accepted.
# API_ORIGIN: the web client's public origin, used in CSP `connectSrc`.
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
API_ORIGIN="http://localhost:5173"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT="6379"
# REDIS_PASSWORD=""  # Uncomment if Redis has password

# Development
NODE_ENV="development"

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARN, ERROR

# Error Handling Configuration
MAX_RETRY_ATTEMPTS=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60000

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000 